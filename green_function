<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green's Function Convolution Engine</title>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 0;
            padding: 20px;
        }
        h2 { margin-bottom: 10px; color: #38bdf8; }
        .dashboard {
            background: #1e293b;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            margin-bottom: 20px;
            display: flex;
            gap: 40px;
            width: 600px;
            box-sizing: border-box;
            justify-content: space-between;
        }
        .control-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }
        canvas {
            background-color: #000000;
            border: 2px solid #334155;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
            cursor: crosshair;
        }
        label { font-weight: bold; font-size: 14px; }
        span { color: #38bdf8; }
        .instructions {
            margin-top: 10px;
            font-size: 14px;
            color: #94a3b8;
        }
        button {
            background-color: #38bdf8;
            color: #0f172a;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
        }
        button:hover {
            background-color: #0284c7;
        }
    </style>
</head>
<body>

    <h2>Green's Function Convolution Engine</h2>
    
    <div class="dashboard">
        <div class="control-group">
            <label>Source Magnitude (q): <span id="qVal">50</span></label>
            <input type="range" id="qSlider" min="-100" max="100" step="10" value="50">
        </div>
        <div class="control-group" style="align-items: flex-end; justify-content: center;">
            <button id="clearBtn">Clear All Sources</button>
        </div>
    </div>

    <!-- 600x400 Canvas for Scalar Field Rendering -->
    <canvas id="simCanvas" width="600" height="400"></canvas>
    
    <div class="instructions">
        Click on the canvas to place a Dirac Delta point source &delta;&sup3;(r - r'). The engine computes the total field &Phi;(r).
    </div>

    <script>
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');
        const qSlider = document.getElementById('qSlider');
        const qDisplay = document.getElementById('qVal');
        const clearBtn = document.getElementById('clearBtn');

        let sources = [];

        function renderField() {
            const imageData = ctx.createImageData(canvas.width, canvas.height);
            const data = imageData.data;

            // Loop over every pixel (r)
            for (let y = 0; y < canvas.height; y++) {
                for (let x = 0; x < canvas.width; x++) {
                    let potential = 0;

                    // Convolve (Sum) the Green's function for all sources (r')
                    for (let i = 0; i < sources.length; i++) {
                        let dx = x - sources[i].x;
                        let dy = y - sources[i].y;
                        
                        // |r - r'|
                        let distance = Math.sqrt(dx * dx + dy * dy);
                        
                        // Prevent singularity blowing up exactly at the pixel center
                        if (distance < 1) distance = 1; 

                        // G(r, r') proportional to 1 / |r - r'|
                        potential += sources[i].q / distance;
                    }

                    // Map potential to color
                    const pixelIndex = (y * canvas.width + x) * 4;
                    
                    if (potential > 0) {
                        // Positive potential (Hot/Orange)
                        let intensity = Math.min(255, Math.floor(potential * 15));
                        data[pixelIndex] = intensity;          // R
                        data[pixelIndex + 1] = Math.floor(intensity * 0.5); // G
                        data[pixelIndex + 2] = 0;              // B
                        data[pixelIndex + 3] = 255;            // A
                    } else {
                        // Negative potential (Cold/Blue)
                        let intensity = Math.min(255, Math.floor(-potential * 15));
                        data[pixelIndex] = 0;                  // R
                        data[pixelIndex + 1] = Math.floor(intensity * 0.5); // G
                        data[pixelIndex + 2] = intensity;      // B
                        data[pixelIndex + 3] = 255;            // A
                    }
                }
            }

            ctx.putImageData(imageData, 0, 0);

            // Draw source markers
            for (let i = 0; i < sources.length; i++) {
                ctx.beginPath();
                ctx.arc(sources[i].x, sources[i].y, 3, 0, Math.PI * 2);
                ctx.fillStyle = sources[i].q > 0 ? '#ffffff' : '#000000';
                ctx.fill();
                ctx.strokeStyle = sources[i].q > 0 ? '#f59e0b' : '#38bdf8';
                ctx.stroke();
            }
        }

        canvas.addEventListener('mousedown', (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const q = parseFloat(qSlider.value);
            
            if (q !== 0) {
                sources.push({ x: x, y: y, q: q });
                renderField();
            }
        });

        qSlider.addEventListener('input', () => {
            qDisplay.innerText = qSlider.value;
        });

        clearBtn.addEventListener('click', () => {
            sources = [];
            renderField();
        });

        // Initial empty render
        renderField();
    </script>
</body>
</html>
